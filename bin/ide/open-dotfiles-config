#!/usr/bin/env bash
# Opens dotfiles configuration files in VS Code.
# Automatically resolves a convention-based repository location.

set -euo pipefail

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") {personal|zsh|git|work|repo}

Options:
  personal     - Open personal-config.zsh
  zsh          - Open .zshrc
  git          - Open git config directory
  work         - Open work-config.zsh
  repo         - Open entire dotfiles repository
EOF
}

CONFIG_TYPE="${1:-}"
case "$CONFIG_TYPE" in
    personal|personal-config|zsh|zshrc|git|gitconfig|work|work-config|repo|dotfiles)
        ;;
    *)
        usage
        exit 2
        ;;
esac

# Find dotfiles directory by checking convention linker sources.
DOTFILES_DIR=""

# Try to resolve from ~/.config-fixing-dot-files-bugs
if [[ -d "$HOME/.config-fixing-dot-files-bugs/home" && -f "$HOME/.config-fixing-dot-files-bugs/bin/core/link-dotfiles.py" ]]; then
    DOTFILES_DIR="$HOME/.config-fixing-dot-files-bugs"
fi

# Fallback: Check common locations
if [[ -z "$DOTFILES_DIR" ]]; then
    for dir in "$HOME/.config-fixing-dot-files-bugs" "$HOME/.config" "$HOME/.dotfiles"; do
        if [[ -d "$dir/home" && -f "$dir/bin/core/link-dotfiles.py" ]]; then
            DOTFILES_DIR="$dir"
            break
        fi
    done
fi

# Error if not found
if [[ -z "$DOTFILES_DIR" || ! -d "$DOTFILES_DIR" ]]; then
    echo "[ERROR] Could not find dotfiles repository" >&2
    exit 1
fi

# Open requested config file
case "$CONFIG_TYPE" in
    personal|personal-config)
        code "$DOTFILES_DIR/home/.config/zsh/personal-config.zsh"
        ;;
    zsh|zshrc)
        code "$DOTFILES_DIR/home/.config/zsh/.zshrc"
        ;;
    git|gitconfig)
        # Open git config files from migrated paths
        code "$DOTFILES_DIR/home/.gitconfig" "$DOTFILES_DIR/home/.config/git"
        ;;
    work|work-config)
        code "$DOTFILES_DIR/home/.config/zsh/work-config.zsh"
        ;;
    repo|dotfiles)
        code "$DOTFILES_DIR"
        ;;
    *)
        usage
        exit 2
        ;;
esac
