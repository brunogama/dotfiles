#!/usr/bin/env bash
#
# check-no-emojis - Check files for emojis
# Enforces MINDSET.MD Rule 2: No emojis in documentation or code

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

files=()
scan_staged=false
if (($#)); then
	files=("$@")
else
	scan_staged=true
	staged_files="$(mktemp)"
	staged_contents="$(mktemp)"
	trap 'rm -f "$staged_files" "$staged_contents"' EXIT
	if ! git diff --cached --name-only -z --diff-filter=ACMR >"$staged_files"; then
		printf 'Failed to read staged files\n' >&2
		exit 1
	fi
	while IFS= read -r -d '' file; do
		files+=("$file")
	done <"$staged_files"
fi

found=false
for file in "${files[@]}"; do
	case "$file" in
	.genesis/*) continue ;;
	esac
	case "$file" in
	*.md | *.sh | *.zsh | *.bash | *.txt | *.yaml | *.json) ;;
	*) continue ;;
	esac

	contents="$file"
	if [[ "$scan_staged" == true ]]; then
		if ! git show ":$file" >"$staged_contents"; then
			printf 'Failed to read staged file: %s\n' "$file" >&2
			exit 1
		fi
		contents="$staged_contents"
	elif [[ ! -f "$file" ]]; then
		continue
	fi

	if ! perl -CSD -ne 'exit 1 if /\p{Extended_Pictographic}|\p{Regional_Indicator}/' <"$contents"; then
		printf '%bERROR: Emojis found in %s%b\n' "$RED" "$file" "$NC"
		echo 'MINDSET.MD Rule 2: No emojis allowed in documentation or code'
		found=true
	fi
done

if [[ "$found" == true ]]; then
	echo
	printf '%bFix: Remove emojis from the files above%b\n' "$YELLOW" "$NC"
	echo 'See MINDSET.MD for constitutional rules'
	exit 1
fi
