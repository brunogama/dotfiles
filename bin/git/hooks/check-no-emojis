#!/usr/bin/env bash
#
# check-no-emojis - Check files for emojis
# Enforces MINDSET.MD Rule 2: No emojis in documentation or code

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

files=()
if (($#)); then
	files=("$@")
else
	while IFS= read -r -d '' file; do
		files+=("$file")
	done < <(git diff --cached --name-only -z --diff-filter=ACM)
fi

found=false
for file in "${files[@]}"; do
	case "$file" in
	*.md | *.sh | *.zsh | *.bash | *.txt | *.yaml | *.json) ;;
	*) continue ;;
	esac

	if [[ -f "$file" ]] &&
		! perl -CSD -ne 'exit 1 if /[\x{1F300}-\x{1F9FF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}\x{231A}-\x{23F3}]/' "$file"; then
		printf '%bERROR: Emojis found in %s%b\n' "$RED" "$file" "$NC"
		echo 'MINDSET.MD Rule 2: No emojis allowed in documentation or code'
		found=true
	fi
done

if [[ "$found" == true ]]; then
	echo
	printf '%bFix: Remove emojis from the files above%b\n' "$YELLOW" "$NC"
	echo 'See MINDSET.MD for constitutional rules'
	exit 1
fi
