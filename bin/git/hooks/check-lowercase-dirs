#!/usr/bin/env bash
#
# check-lowercase-dirs - Check all directories are lowercase
# Enforces MINDSET.MD Rule 1: All directories MUST be lowercase
#

set -euo pipefail

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# home-darwin mirrors macOS destination paths. Library and its descendants are
# intentionally exempt because macOS requires the uppercase destination name.
FOUND=false

while IFS= read -r -d '' dir; do
    dir="${dir#./}"
    if [[ "$dir" == "home-darwin/Library" || "$dir" == home-darwin/Library/* ]]; then
        continue
    fi
    if [[ "$dir" =~ [A-Z] ]]; then
        echo -e "${RED}ERROR: Uppercase directory found: $dir${NC}"
        echo "MINDSET.MD Rule 1: All directories MUST be lowercase"
        FOUND=true
    fi
done < <(
    find . -type d \
        -not -path "./.git/*" \
        -not -path "./.git" \
        -not -path "./.claude/*" \
        -not -path "./home-darwin/Library" \
        -not -path "./home-darwin/Library/*" \
        -not -path "*/node_modules" \
        -not -path "*/node_modules/*" \
        -not -path "*/.cache" \
        -not -path "*/.cache/*" \
        -print0
)

if [[ "$FOUND" == "true" ]]; then
    echo ""
    echo -e "${YELLOW}Fix: Rename directories to lowercase${NC}"
    echo "  Example: mv Directory directory"
    echo ""
    echo "See MINDSET.MD for constitutional rules"
    exit 1
fi

exit 0
