#!/usr/bin/env bash

# Environment Switcher
# Switch between work and personal environments

set -euo pipefail

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/zsh/environment.zsh"
LEGACY_ZSHENV_BACKUP="$HOME/.zshenv.pre-nix"
OLD_MARKER="$HOME/.work-machine"

# Atomically update the mutable environment state without touching managed files.
write_environment() {
    local mode="$1"
    local env_dir
    local temp_file

    env_dir="$(dirname "$ENV_FILE")"
    mkdir -p "$env_dir"
    temp_file="$(mktemp "$env_dir/.environment.zsh.XXXXXX")"

    if [[ -f "$ENV_FILE" ]]; then
        grep -v '^export DOTFILES_ENV=' "$ENV_FILE" > "$temp_file" || true
    fi
    if [[ "$mode" == "work" ]]; then
        printf '%s\n' 'export DOTFILES_ENV=work' >> "$temp_file"
    fi

    chmod 600 "$temp_file"
    mv "$temp_file" "$ENV_FILE"
}

# Get current environment from the dedicated mutable state file.
get_current_env() {
    if [[ -f "$ENV_FILE" ]] && grep -q '^export DOTFILES_ENV=work$' "$ENV_FILE"; then
        echo "work"
    else
        echo "personal"
    fi
}

set_work_env() {
    write_environment work
}

set_personal_env() {
    write_environment personal
}

# Migrate state left by the marker-based flow or Home Manager's first backup.
migrate_old_system() {
    local migrated=false

    if [[ -f "$OLD_MARKER" ]]; then
        echo -e "${YELLOW}Migrating from old marker file system...${NC}"
        set_work_env
        rm "$OLD_MARKER"
        echo -e "${GREEN}Migration complete: Removed old marker file${NC}"
        migrated=true
    fi

    if [[ ! -f "$ENV_FILE" && -f "$LEGACY_ZSHENV_BACKUP" ]]; then
        if grep -q '^export DOTFILES_ENV=work$' "$LEGACY_ZSHENV_BACKUP"; then
            echo -e "${YELLOW}Migrating work mode from ~/.zshenv.pre-nix...${NC}"
            set_work_env
            echo -e "${GREEN}Migration complete: State moved to ~/.config/zsh/environment.zsh${NC}"
            migrated=true
        fi
    fi

    [[ "$migrated" == "true" ]]
}

# Offer to reload shell
offer_reload() {
    echo ""
    echo -e "${YELLOW}Reload your shell to apply changes:${NC}"
    echo -e "   ${BLUE}exec zsh${NC}"
    echo ""
    read -p "Reload shell now? (y/n) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        exec zsh
    fi
}

# Migrate legacy state before handling any command.
migrate_old_system || true

# Main command handling
case "${1:-status}" in
    "work"|"on"|"enable")
        current=$(get_current_env)
        if [[ "$current" == "work" ]]; then
            echo -e "${BLUE}Already in work environment${NC}"
            exit 0
        fi

        set_work_env
        echo -e "${GREEN}Switched to work environment${NC}"
        offer_reload
        ;;

    "personal"|"home"|"off"|"disable")
        current=$(get_current_env)
        if [[ "$current" == "personal" ]]; then
            echo -e "${BLUE}Already in personal environment${NC}"
            exit 0
        fi

        set_personal_env
        echo -e "${GREEN}Switched to personal environment${NC}"
        offer_reload
        ;;

    "status")
        # Check for migration needed
        if [[ -f "$OLD_MARKER" ]]; then
            echo -e "${YELLOW}Old marker file detected: $OLD_MARKER${NC}"
            echo -e "${YELLOW}   Run 'work-mode work' or 'work-mode personal' to migrate${NC}"
            echo ""
        fi

        current=$(get_current_env)
        if [[ "$current" == "work" ]]; then
            echo -e "${GREEN}Current environment: WORK${NC}"
            echo "   Variable: DOTFILES_ENV=work"
            echo "   Storage file: ~/.config/zsh/environment.zsh"
            echo "   Config file: ~/.config/zsh/work-config.zsh"
        else
            echo -e "${BLUE}Current environment: PERSONAL${NC}"
            echo "   Variable: DOTFILES_ENV not set (default)"
            echo "   Storage file: ~/.config/zsh/environment.zsh"
            echo "   Config file: ~/.config/zsh/personal-config.zsh"
        fi
        ;;

    "help"|"-h"|"--help")
        cat << 'EOF'
Environment Switcher

Switch between work and personal dotfiles environments.

Usage: work-mode [COMMAND]

COMMANDS:
    work, on, enable          Switch to work environment
    personal, home, off       Switch to personal environment
    status                    Show current environment
    help                      Show this help message

EXAMPLES:
    work-mode work           # Switch to work (shows "WORK" in prompt)
    work-mode personal       # Switch to personal (shows "HOME:PERSONAL")
    work-mode status         # Check which environment is active

WHAT IT DOES:
    - Work mode: Sets DOTFILES_ENV=work in ~/.config/zsh/environment.zsh
    - Personal mode: Removes DOTFILES_ENV from that state file
    - Changes take effect after shell reload (exec zsh)

NOTES:
    - Safe to run multiple times
    - Uses atomic writes outside Home Manager-owned files
    - Migrates old ~/.work-machine and ~/.zshenv.pre-nix work state

EOF
        ;;

    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Run 'work-mode help' for usage"
        exit 1
        ;;
esac
