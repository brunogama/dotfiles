#!/usr/bin/env bash
set -euo pipefail

if ! command -v periphery &> /dev/null; then
    echo "Periphery is missing from this machine." >&2
    exit 2
fi

folder_name="$(basename "$(pwd)")"

xcodebuild \
    -scheme "$folder_name" \
    -destination 'platform=iOS Simulator,OS=18.2,name=iPhone 16' \
    -derivedDataPath ~/Desktop/dd \
    clean build

periphery scan \
    --skip-build \
    --index-store-path ~/Desktop/dd/Index.noindex/DataStore/ \
    --retain-public true \
    --targets "$folder_name"

rm -rf ~/Desktop/dd
