#!/usr/bin/env bash

set -euo pipefail

resolve_script_dir() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
        source_path="$(readlink "$source_path")"
        [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
    done

    cd -P "$(dirname "$source_path")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
readonly SCRIPT_DIR
DOTFILES_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
readonly DOTFILES_ROOT

DRY_RUN=false
CHECK_ONLY=false
MANIFEST_DIR="$DOTFILES_ROOT/packages/npm"

usage() {
    cat <<'EOF'
Usage: nix-npm-sync [OPTIONS]

Install the pinned npm toolchain into a versioned user data directory.

Options:
  --check                  Verify that the locked version is active
  --dry-run                Print the requested action without changing files
  --manifest-dir PATH      Use a different package.json/package-lock.json directory
  -h, --help               Show this help message
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --check)
            CHECK_ONLY=true
            ;;
        --dry-run)
            DRY_RUN=true
            ;;
        --manifest-dir)
            [[ $# -ge 2 ]] || { echo "nix-npm-sync: --manifest-dir requires a path" >&2; exit 2; }
            MANIFEST_DIR="$2"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "nix-npm-sync: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

readonly PACKAGE_JSON="$MANIFEST_DIR/package.json"
readonly PACKAGE_LOCK="$MANIFEST_DIR/package-lock.json"

[[ -f "$PACKAGE_JSON" ]] || { echo "nix-npm-sync: missing $PACKAGE_JSON" >&2; exit 2; }
[[ -f "$PACKAGE_LOCK" ]] || { echo "nix-npm-sync: missing $PACKAGE_LOCK" >&2; exit 2; }

command -v shasum >/dev/null 2>&1 || { echo "nix-npm-sync: shasum is required" >&2; exit 2; }

MANIFEST_HASH="$(cat "$PACKAGE_JSON" "$PACKAGE_LOCK" | shasum -a 256 | awk '{print $1}')"
readonly MANIFEST_HASH
readonly DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly INSTALL_ROOT="$DATA_HOME/dotfiles/npm"
readonly VERSION_DIR="$INSTALL_ROOT/versions/$MANIFEST_HASH"
readonly CURRENT_LINK="$INSTALL_ROOT/current"
readonly EXPECTED_LINK="versions/$MANIFEST_HASH"

is_current() {
    [[ -L "$CURRENT_LINK" ]] \
        && [[ "$(readlink "$CURRENT_LINK")" == "$EXPECTED_LINK" ]] \
        && [[ -x "$CURRENT_LINK/node_modules/.bin/pi" ]]
}

if is_current; then
    echo "npm tools already match package-lock.json ($MANIFEST_HASH)"
    exit 0
fi

if [[ "$CHECK_ONLY" == "true" ]]; then
    echo "nix-npm-sync: locked npm tools are not active" >&2
    exit 1
fi

if [[ "$DRY_RUN" == "true" ]]; then
    echo "Would install pinned npm tools into $VERSION_DIR"
    echo "Would point $CURRENT_LINK to $EXPECTED_LINK"
    exit 0
fi

command -v npm >/dev/null 2>&1 || { echo "nix-npm-sync: npm is required (enter 'nix develop' first)" >&2; exit 2; }

mkdir -p "$INSTALL_ROOT/versions"

if [[ ! -d "$VERSION_DIR" ]]; then
    staging_dir="$(mktemp -d "$INSTALL_ROOT/.install.XXXXXX")"
    cleanup() {
        rm -rf "$staging_dir"
    }
    trap cleanup EXIT

    cp "$PACKAGE_JSON" "$PACKAGE_LOCK" "$staging_dir/"
    (
        cd "$staging_dir"
        npm ci --omit=dev --no-audit --no-fund
    )
    mv "$staging_dir" "$VERSION_DIR"
    trap - EXIT
fi

ln -sfn "$EXPECTED_LINK" "$CURRENT_LINK"
echo "Activated pinned npm tools: $CURRENT_LINK"
