#!/usr/bin/env bash
# Launches Pi with only its supported provider API keys.

set -euo pipefail
IFS=$'\n\t'

resolve_script_dir() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
        source_path="$(readlink "$source_path")"
        [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
    done

    cd -P "$(dirname "$source_path")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
readonly SCRIPT_DIR
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/agent-credential-loader.sh"

# Pi provider credentials listed by `pi --help`; keep this list explicit so
# unrelated Keychain credentials are never exposed to the Pi process.
readonly -a PI_PROVIDER_API_KEYS=(
    ANTHROPIC_API_KEY
    ANT_LING_API_KEY
    OPENAI_API_KEY
    AZURE_OPENAI_API_KEY
    DEEPSEEK_API_KEY
    NVIDIA_API_KEY
    GEMINI_API_KEY
    GROQ_API_KEY
    CEREBRAS_API_KEY
    XAI_API_KEY
    FIREWORKS_API_KEY
    TOGETHER_API_KEY
    OPENROUTER_API_KEY
    AI_GATEWAY_API_KEY
    ZAI_API_KEY
    ZAI_CODING_CN_API_KEY
    MISTRAL_API_KEY
    MINIMAX_API_KEY
    MOONSHOT_API_KEY
    OPENCODE_API_KEY
    KIMI_API_KEY
    CLOUDFLARE_API_KEY
    QWEN_TOKEN_PLAN_API_KEY
    QWEN_TOKEN_PLAN_CN_API_KEY
    XIAOMI_API_KEY
    XIAOMI_TOKEN_PLAN_CN_API_KEY
    XIAOMI_TOKEN_PLAN_AMS_API_KEY
    XIAOMI_TOKEN_PLAN_SGP_API_KEY
)
load_agent_api_keys "${PI_PROVIDER_API_KEYS[@]}"

readonly PI_BIN="${DOTFILES_PI_BIN:-${DOTFILES_NPM_BIN:-${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/npm/current/node_modules/.bin}/pi}"
[[ -x "$PI_BIN" ]] || {
    echo "pi: executable not found; run nix-npm-sync or set DOTFILES_PI_BIN" >&2
    exit 127
}

exec "$PI_BIN" "$@"
