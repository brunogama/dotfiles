#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["cryptography"]
# ///
"""Squash local drafts into one App-authored commit via the Git Data API.

Computes every change in the working tree relative to a base ref, uploads the
changed blobs, builds a new tree and commit authenticated as the GitHub App,
and force-updates the branch ref. The agent's local (jj/git) history is then
discarded and resynced onto the new App-authored commit.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import padding

API_URL = "https://api.github.com"
USER_AGENT = "dotfiles-agent"


def _b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def build_jwt(app_id: str, private_key_pem: bytes) -> str:
    now = int(time.time())
    header = _b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    payload = _b64url(
        json.dumps({"iat": now - 60, "exp": now + 540, "iss": app_id}).encode()
    )
    signing_input = f"{header}.{payload}".encode()
    key = serialization.load_pem_private_key(private_key_pem, password=None)
    signature = key.sign(signing_input, padding.PKCS1v15(), hashes.SHA256())
    return f"{header}.{payload}.{_b64url(signature)}"


def api_request(token: str, method: str, path: str, body: dict | None = None) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(API_URL + path, data=data, method=method)
    request.add_header("Accept", "application/vnd.github+json")
    request.add_header("X-GitHub-Api-Version", "2022-11-28")
    request.add_header("Authorization", f"Bearer {token}")
    request.add_header("User-Agent", USER_AGENT)
    if data is not None:
        request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        raise RuntimeError(
            f"GitHub API {method} {path} failed: HTTP {exc.code} {detail}"
        ) from exc


def mint_token(app_id: str, private_key_pem: bytes, repo: str) -> str:
    jwt = build_jwt(app_id, private_key_pem)
    installation = api_request(jwt, "GET", f"/repos/{repo}/installation")["id"]
    data = api_request(jwt, "POST", f"/app/installations/{installation}/access_tokens")
    token = data.get("token")
    if not token:
        raise RuntimeError("no token in installation response")
    return token


def git(*args: str) -> str:
    return subprocess.check_output(["git", *args], text=True).rstrip("\n")


def _resolve_base(branch: str) -> str:
    for ref in ("@{upstream}", f"origin/{branch}"):
        try:
            return git("rev-parse", ref)
        except subprocess.CalledProcessError:
            continue
    raise RuntimeError(f"no base for branch {branch}; pass --base")


def parse_repo_url(url: str) -> str:
    url = url.strip().rstrip("/")
    if url.endswith(".git"):
        url = url[:-4]
    for marker in ("github.com/", "github.com:"):
        if marker in url:
            return url.split(marker, 1)[1]
    return url


def changed_entries(base: str) -> list[tuple[str, str]]:
    """Return (status, path) pairs for everything differing from base.

    status is one of A (add), M (modify), D (delete).
    """
    entries: dict[str, str] = {}
    tracked = subprocess.run(
        ["git", "diff", "--name-status", "-z", base],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    for status, path in _parse_name_status(tracked):
        entries[path] = status
    untracked = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard", "-z"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    for path in untracked.split("\0"):
        if path:
            entries[path] = "A"
    return sorted(entries.items())


def _parse_name_status(raw: str) -> list[tuple[str, str]]:
    parts = raw.split("\0")
    result: list[tuple[str, str]] = []
    index = 0
    while index < len(parts):
        status_token = parts[index]
        index += 1
        if not status_token:
            continue
        status = status_token[0]
        if status in ("R", "C") and index + 1 < len(parts):
            # rename/copy emits status, old path, new path.
            new_path = parts[index + 1]
            index += 2
            result.append((status, new_path))
        elif index < len(parts):
            path = parts[index]
            index += 1
            result.append((status, path))
    return result


def mode_for(path: Path) -> str:
    return "100755" if path.is_file() and os.access(path, os.X_OK) else "100644"


def _resync(branch: str, new_sha: str) -> None:
    """Resync the local checkout onto the newly created App commit."""
    if Path(".jj").is_dir():
        subprocess.run(["jj", "git", "fetch"], check=True)
        subprocess.run(["jj", "bookmark", "set", branch, "-r", new_sha], check=False)
        subprocess.run(["jj", "new", new_sha], check=False)
        print("agent-push: resynced jj; squashed drafts remain, abandon manually")
    else:
        subprocess.run(["git", "fetch", "origin"], check=True)
        subprocess.run(["git", "reset", "--hard", f"origin/{branch}"], check=True)
        print("agent-push: resynced working tree to", new_sha)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--app-id", help="GitHub App ID")
    parser.add_argument("--key-file", help="PEM private key (default: stdin)")
    parser.add_argument("--token", help="pre-minted installation token")
    parser.add_argument("--repo", help="owner/repo (default: git remote origin)")
    parser.add_argument("--branch", help="branch to update (default: current)")
    parser.add_argument("--base", help="base ref (default: branch upstream)")
    parser.add_argument("--message", default="agent: squash commit")
    parser.add_argument("--name", help="committer name (default: git user.name)")
    parser.add_argument("--email", help="committer email (default: git user.email)")
    parser.add_argument(
        "--dry-run", action="store_true", help="print plan, no API calls"
    )
    parser.add_argument(
        "--resync",
        action="store_true",
        help="resync local checkout onto the new commit after push",
    )
    args = parser.parse_args()

    repo = args.repo or parse_repo_url(git("config", "--get", "remote.origin.url"))
    if not repo:
        print("agent-push: cannot determine repository", file=sys.stderr)
        return 2
    branch = args.branch or git("rev-parse", "--abbrev-ref", "HEAD")
    base_sha = git("rev-parse", args.base) if args.base else _resolve_base(branch)
    name = args.name or git("config", "--get", "user.name")
    email = args.email or git("config", "--get", "user.email")

    entries = changed_entries(base_sha)
    if not entries:
        print("agent-push: no changes relative to", base_sha)
        return 0

    if args.dry_run:
        print(f"repo={repo} branch={branch} base={base_sha}")
        for status, path in entries:
            print(f"  {status} {path}")
        print(f"message={args.message!r} name={name!r} email={email!r}")
        return 0

    token = args.token
    if not token:
        app_id = args.app_id or git("config", "--get", "dotfiles.githubAppId") or ""
        if not app_id:
            print("agent-push: --app-id or GH token required", file=sys.stderr)
            return 2
        if args.key_file:
            key = Path(args.key_file).read_bytes()
        else:
            key = sys.stdin.buffer.read()
        token = mint_token(app_id, key, repo)

    tree_entries: list[dict] = []
    for status, path in entries:
        disk_path = Path(path)
        if status == "D" or not disk_path.exists():
            tree_entries.append(
                {"path": path, "mode": "100644", "type": "blob", "sha": None}
            )
            continue
        content = disk_path.read_bytes()
        blob = api_request(
            token,
            "POST",
            f"/repos/{repo}/git/blobs",
            {
                "content": base64.b64encode(content).decode(),
                "encoding": "base64",
            },
        )
        tree_entries.append(
            {
                "path": path,
                "mode": mode_for(disk_path),
                "type": "blob",
                "sha": blob["sha"],
            }
        )

    base_commit = api_request(token, "GET", f"/repos/{repo}/git/commits/{base_sha}")
    tree = api_request(
        token,
        "POST",
        f"/repos/{repo}/git/trees",
        {
            "base_tree": base_commit["tree"]["sha"],
            "tree": tree_entries,
        },
    )
    commit = api_request(
        token,
        "POST",
        f"/repos/{repo}/git/commits",
        {
            "message": args.message,
            "tree": tree["sha"],
            "parents": [base_sha],
            "author": {"name": name, "email": email, "date": _now_iso()},
            "committer": {"name": name, "email": email, "date": _now_iso()},
        },
    )
    api_request(
        token,
        "PATCH",
        f"/repos/{repo}/git/refs/heads/{branch}",
        {
            "sha": commit["sha"],
            "force": True,
        },
    )
    print(commit["sha"])
    if args.resync:
        _resync(branch, commit["sha"])
    return 0


def _now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"agent-push: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
