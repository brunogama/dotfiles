#!/usr/bin/env bash
# Launches Codex with its optional OpenAI API key.

set -euo pipefail

resolve_script_dir() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
        source_path="$(readlink "$source_path")"
        [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
    done

    cd -P "$(dirname "$source_path")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
readonly SCRIPT_DIR
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/agent-credential-loader.sh"

load_agent_api_key OPENAI_API_KEY

readonly CODEX_BIN="${DOTFILES_CODEX_BIN:-$HOME/.codex/packages/standalone/current/bin/codex}"
[[ -x "$CODEX_BIN" ]] || {
    echo "codex: executable not found; install Codex or set DOTFILES_CODEX_BIN" >&2
    exit 127
}

exec "$CODEX_BIN" "$@"
