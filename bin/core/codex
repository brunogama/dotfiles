#!/usr/bin/env bash
# Launches Codex with its optional OpenAI API key.

set -euo pipefail
IFS=$'\n\t'

resolve_script_dir() {
    local source_path="${BASH_SOURCE[0]}"
    local source_dir

    while [[ -L "$source_path" ]]; do
        source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
        source_path="$(readlink "$source_path")"
        [[ "$source_path" == /* ]] || source_path="$source_dir/$source_path"
    done

    cd -P "$(dirname "$source_path")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
readonly SCRIPT_DIR
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/agent-credential-loader.sh"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib/agent-session.sh"

find_codex_bin() {
    local candidate

    for candidate in \
        "$HOME/.local/bin/codex" \
        "$HOME/.codex/packages/standalone/current/bin/codex"; do
        [[ -x "$candidate" && ! "$candidate" -ef "${BASH_SOURCE[0]}" ]] || continue
        printf '%s\n' "$candidate"
        return 0
    done

    return 1
}

load_agent_api_key OPENAI_API_KEY

CODEX_BIN="${DOTFILES_CODEX_BIN:-}"
if [[ -z "$CODEX_BIN" ]]; then
    CODEX_BIN="$(find_codex_bin || true)"
fi
[[ -n "$CODEX_BIN" && -x "$CODEX_BIN" ]] || {
    echo "codex: executable not found; install Codex or set DOTFILES_CODEX_BIN" >&2
    exit 127
}
readonly CODEX_BIN

run_agent codex "$CODEX_BIN" "$@"
