#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["cryptography"]
# ///
"""Mint a GitHub App installation token for the current repository.

Reads the App private key (PEM) from stdin (or --key-file), builds a short-lived
RS256 JWT, resolves the App installation for the repository, and prints an
installation access token to stdout.
"""

from __future__ import annotations

import argparse
import base64
import json
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

from cryptography.hazmat.primitives import hashes, serialization
from cryptography.hazmat.primitives.asymmetric import padding

API_URL = "https://api.github.com"
USER_AGENT = "dotfiles-agent"


def _b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def build_jwt(app_id: str, private_key_pem: bytes) -> str:
    """Build a short-lived RS256 JWT signed with the App private key."""
    now = int(time.time())
    header = _b64url(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
    payload = _b64url(
        json.dumps({"iat": now - 60, "exp": now + 540, "iss": app_id}).encode()
    )
    signing_input = f"{header}.{payload}".encode()
    key = serialization.load_pem_private_key(private_key_pem, password=None)
    signature = key.sign(signing_input, padding.PKCS1v15(), hashes.SHA256())
    return f"{header}.{payload}.{_b64url(signature)}"


def api_request(jwt: str, method: str, path: str) -> dict:
    request = urllib.request.Request(API_URL + path, method=method)
    request.add_header("Accept", "application/vnd.github+json")
    request.add_header("X-GitHub-Api-Version", "2022-11-28")
    request.add_header("Authorization", f"Bearer {jwt}")
    request.add_header("User-Agent", USER_AGENT)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode(errors="replace")
        raise RuntimeError(
            f"GitHub API {method} {path} failed: HTTP {exc.code} {detail}"
        ) from exc


def parse_repo_url(url: str) -> str:
    """Extract owner/repo from a remote URL or a bare owner/repo string."""
    url = url.strip().rstrip("/")
    if not url:
        return ""
    if url.endswith(".git"):
        url = url[:-4]
    for marker in ("github.com/", "github.com:"):
        if marker in url:
            return url.split(marker, 1)[1]
    if "/" in url and "://" not in url:
        return url
    return ""


def derive_repo() -> str:
    try:
        url = subprocess.check_output(
            ["git", "config", "--get", "remote.origin.url"],
            stderr=subprocess.DEVNULL,
            text=True,
        ).strip()
    except (subprocess.CalledProcessError, OSError):
        url = ""
    return parse_repo_url(url)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--app-id", required=True, help="GitHub App ID")
    parser.add_argument("--repo", help="owner/repo or a git remote URL")
    parser.add_argument("--installation-id", help="skip repository resolution")
    parser.add_argument("--key-file", help="PEM private key path (default: stdin)")
    args = parser.parse_args()

    if args.key_file:
        private_key_pem = Path(args.key_file).read_bytes()
    else:
        private_key_pem = sys.stdin.buffer.read()

    jwt = build_jwt(args.app_id, private_key_pem)

    if args.installation_id:
        installation_id = args.installation_id
    else:
        repo = args.repo or derive_repo()
        if not repo:
            print(
                "agent-github-token: cannot determine repository; "
                "pass --repo or --installation-id",
                file=sys.stderr,
            )
            return 2
        installation_id = api_request(jwt, "GET", f"/repos/{repo}/installation")["id"]

    data = api_request(
        jwt, "POST", f"/app/installations/{installation_id}/access_tokens"
    )
    token = data.get("token")
    if not token:
        print("agent-github-token: no token in response", file=sys.stderr)
        return 1
    print(token)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, ValueError) as exc:
        print(f"agent-github-token: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
