#!/bin/bash
# Export this laptop's Keychain API keys into production's ~/.envrc.
# Requires dump-api-keys locally and SSH access to production.
set -euo pipefail

api_keys=$(dump-api-keys)
if [[ -z "$api_keys" ]]; then
    printf '%s\n' 'No API keys exported; production ~/.envrc was not changed.' >&2
    exit 1
fi
printf '%s\n' "$api_keys" | ssh production 'umask 077; touch ~/.envrc && chmod 600 ~/.envrc && cat >| ~/.envrc'
