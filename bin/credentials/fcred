#!/usr/bin/env bash
#
# fcred - Fuzzy picker for credentials stored in the credmatch store.
#
# Prompts for the credmatch master password, lists the key=secret pairs,
# lets the user pick one with FZF, then prints the value. With -c, copies
# the secret to the clipboard instead of printing it.

set -euo pipefail

if ! command -v fzf >/dev/null 2>&1; then
    echo "fcred: fzf is not installed" >&2
    exit 1
fi

if ! command -v credmatch >/dev/null 2>&1 && [[ ! -x "$HOME/local/bin/credmatch" ]]; then
    echo "fcred: credmatch is not installed" >&2
    exit 1
fi

ACTION="print"
if [[ "${1:-}" == "-c" || "${1:-}" == "--copy" ]]; then
    ACTION="copy"
fi

# Use the same secure prompt as credmatch. Avoid history and process lists.
HISTCONTROL=ignorespace:ignoredups

# credmatch prints "<key>=<value>" pairs once the master password unlocks
# the encrypted store. Run it once and capture output.
if ! raw=$(credmatch list < /dev/null 2>/dev/null); then
    echo "fcred: could not read credential store" >&2
    exit 1
fi

# Strip ANSI colour codes and the "Stored Credentials:" banner credmatch
# prints. Keep one entry per line in "key=value" form.
entries=$(
    printf '%s\n' "$raw" |
        sed -E $'s/\x1b\\[[0-9;]*m//g' |
        awk -F= '
            /^Stored Credentials/ {next}
            /^$/ {next}
            NF >= 2 {key=$1; sub(/^[^A-Za-z0-9_.:-]+/, "", key); printf "%s\t%s\n", key, $0}
        '
)

if [[ -z "$entries" ]]; then
    echo "fcred: credential store is empty" >&2
    exit 1
fi

selected=$(
    printf '%s\n' "$entries" |
        fzf --height=60% --layout=reverse --border \
            --with-nth=1 \
            --delimiter='\t' \
            --prompt='credential> ' \
            --header='Pick a credential (key only is shown in the list)'
)

[[ -z "$selected" ]] && exit 0

key=$(printf '%s' "$selected" | cut -f1)
value=$(credmatch get "$key" < /dev/null 2>/dev/null || true)

if [[ -z "$value" ]]; then
    echo "fcred: failed to retrieve value for '$key'" >&2
    exit 1
fi

if [[ "$ACTION" == "copy" ]] && command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$value" | pbcopy
    echo "fcred: copied '$key' to clipboard" >&2
    value=""
else
    printf '%s\n' "$value"
    value=""
fi
