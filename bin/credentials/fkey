#!/usr/bin/env bash
#
# fkey - Fuzzy picker for API keys stored in the macOS Keychain.
#
# Lists all generic passwords owned by the current user, lets the user
# pick one with FZF, then prints the secret value. With -c, copies the
# secret to the clipboard instead of printing it.

set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "fkey: macOS keychain is only available on Darwin" >&2
    exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
    echo "fkey: fzf is not installed" >&2
    exit 1
fi

ACTION="print"
if [[ "${1:-}" == "-c" || "${1:-}" == "--copy" ]]; then
    ACTION="copy"
fi

# List generic password service names owned by the current user. The
# dump-keychain output is human-readable text; awk isolates the "svce"
# attribute and dedupes results.
services=$(
    security dump-keychain ~/Library/Keychains/login.keychain-db 2>/dev/null |
        awk -F'"' '/"svce"<blob>=/ {print $4}' |
        sort -u
)

if [[ -z "$services" ]]; then
    echo "fkey: no keychain entries found for $USER" >&2
    exit 1
fi

selected=$(
    printf '%s\n' "$services" |
    fzf --height=60% --layout=reverse --border \
        --prompt='keychain> ' \
        --header='Pick a stored API key (ENTER prints, CTRL-C cancels)'
)

[[ -z "$selected" ]] && exit 0

value=$(security find-generic-password -a "$USER" -s "$selected" -w 2>/dev/null || true)

if [[ -z "$value" ]]; then
    echo "fkey: failed to retrieve value for '$selected'" >&2
    exit 1
fi

if [[ "$ACTION" == "copy" ]] && command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$value" | pbcopy
    echo "fkey: copied '$selected' to clipboard" >&2
    # Clear the local copy so it does not linger in this shell.
    value=""
else
    printf '%s\n' "$value"
    value=""
fi
