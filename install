#!/usr/bin/env bash
#
# install - One-command dotfiles installation
#
# Usage: ./install [OPTIONS]

set -euo pipefail

# Script metadata
readonly INSTALL_SCRIPT_VERSION="1.0.0"

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m' # No Color

# Shared flags
DRY_RUN=false
YES=false
SCRIPTS_ONLY=false
VERBOSE=false

# Router flags
BACKEND="auto"
BACKEND_SELECTOR=""
SYSTEM_MODE=false
CONFIGURATION=""
USERNAME_VALUE=""
MACHINE_NAME=""
SKIP_NPM=false
NIX_DISTRIBUTION="upstream"
NIX_DISTRIBUTION_EXPLICIT=false
ALLOW_MIXED_BACKENDS=false

# Legacy installer flags
SKIP_PACKAGES=false
SKIP_LINKS=false

# Detect platform
PLATFORM="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "$PLATFORM" in
    darwin) PLATFORM="darwin" ;;
    linux) PLATFORM="linux" ;;
    *) PLATFORM="unknown" ;;
esac

# Detect dotfiles root
DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Logging functions (ASCII-safe, no unicode/emoji)
log_info() {
    echo -e "${BLUE}[i]${NC} $*"
}

log_success() {
    echo -e "${GREEN}[+]${NC} $*"
}

log_warning() {
    echo -e "${YELLOW}[!]${NC} $*"
}

log_error() {
    echo -e "${RED}[x]${NC} $*"
}

log_phase() {
    echo ""
    echo -e "${CYAN}======================================${NC}"
    echo -e "${CYAN} $*${NC}"
    echo -e "${CYAN}======================================${NC}"
    echo ""
}

log_verbose() {
    if [[ "$VERBOSE" == "true" ]]; then
        log_info "$*"
    fi
}

# Show usage
usage() {
    cat << EOF
install v${INSTALL_SCRIPT_VERSION}
One-command dotfiles installation

USAGE:
    ./install [OPTIONS]

OPTIONS:
    --backend MODE     Select auto, nix, or legacy (default: auto)
    --nix              Compatibility alias for --backend nix
    --legacy           Alias for --backend legacy
    --system           Activate privileged nix-darwin settings (Nix only)
    --configuration NAME
                       Select the Nix flake configuration (Nix only)
    --username NAME    Set the macOS account short name (Nix only)
    --machine-name NAME
                       Set the Mac and normalized host names (Nix only)
    --nix-distribution MODE
                       Declare upstream or determinate Nix ownership (Nix only)
    --skip-npm         Do not synchronize pinned npm tools (Nix only)
    --allow-mixed-backends
                       Permit legacy mode on a Home Manager-managed macOS setup
    --dry-run          Preview the selected backend without changing the system
    --yes              Non-interactive mode (assume installer confirmations)
    --skip-packages    Skip package installation (legacy only)
    --skip-links       Skip symlink creation (legacy only)
    --scripts-only     Only link public commands to ~/.local/bin
    --verbose          Show detailed output
    --help             Show this help message

EXAMPLES:
    # Preview automatic platform selection
    ./install --dry-run

    # Install the default user environment
    ./install

    # Force a backend
    ./install --backend nix
    ./install --legacy

    # Optional privileged macOS system activation
    ./install --system

    # Only update public commands in ~/.local/bin
    ./install --scripts-only


EXIT CODES:
    0    Success
    1    General error
    2    Prerequisites not met
    3    User cancelled

EOF
}

# Record a single explicit backend selection.
select_install_backend() {
    local requested_backend="$1"

    if [[ -n "$BACKEND_SELECTOR" && "$BACKEND" != "$requested_backend" ]]; then
        log_error "Conflicting backend selectors: $BACKEND_SELECTOR and $requested_backend"
        exit 2
    fi

    BACKEND="$requested_backend"
    BACKEND_SELECTOR="$requested_backend"
}

# Parse router and backend arguments before selecting an installer.
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --backend)
                [[ $# -ge 2 ]] || { log_error "--backend requires auto, nix, or legacy"; exit 2; }
                case "$2" in
                    auto|nix|legacy) select_install_backend "$2" ;;
                    *) log_error "Unknown backend: $2"; exit 2 ;;
                esac
                shift
                ;;
            --nix)
                select_install_backend "nix"
                ;;
            --legacy)
                select_install_backend "legacy"
                ;;
            --system)
                SYSTEM_MODE=true
                ;;
            --configuration)
                [[ $# -ge 2 ]] || { log_error "--configuration requires a name"; exit 2; }
                CONFIGURATION="$2"
                shift
                ;;
            --username)
                [[ $# -ge 2 ]] || { log_error "--username requires a name"; exit 2; }
                USERNAME_VALUE="$2"
                shift
                ;;
            --machine-name)
                [[ $# -ge 2 ]] || { log_error "--machine-name requires a name"; exit 2; }
                MACHINE_NAME="$2"
                shift
                ;;
            --nix-distribution)
                [[ $# -ge 2 ]] || { log_error "--nix-distribution requires upstream or determinate"; exit 2; }
                case "$2" in
                    upstream|determinate)
                        NIX_DISTRIBUTION="$2"
                        NIX_DISTRIBUTION_EXPLICIT=true
                        ;;
                    *) log_error "Unknown Nix distribution: $2"; exit 2 ;;
                esac
                shift
                ;;
            --skip-npm)
                SKIP_NPM=true
                ;;
            --allow-mixed-backends)
                ALLOW_MIXED_BACKENDS=true
                ;;
            --dry-run)
                DRY_RUN=true
                ;;
            --yes)
                YES=true
                ;;
            --skip-packages)
                SKIP_PACKAGES=true
                ;;
            --skip-links)
                SKIP_LINKS=true
                ;;
            --scripts-only)
                SCRIPTS_ONLY=true
                ;;
            --verbose)
                VERBOSE=true
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                usage >&2
                exit 2
                ;;
        esac
        shift
    done
}

# Confirm action
confirm() {
    if [[ "$YES" == "true" ]]; then
        return 0
    fi

    local prompt="$1"
    echo -n "$prompt (y/n): "
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        return 0
    fi
    return 1
}

# Check if command exists
command_exists() {
    command -v "$1" &> /dev/null
}

# Download an installer before executing it so failures never execute partial content.
run_remote_bash_installer() {
    local installer_url="$1"
    local installer

    installer="$(mktemp)"
    if ! curl --proto '=https' --tlsv1.2 -fsSL "$installer_url" -o "$installer"; then
        rm -f "$installer"
        return 1
    fi

    if ! /bin/bash "$installer"; then
        rm -f "$installer"
        return 1
    fi

    rm -f "$installer"
}

# Pre-flight checks
phase_preflight() {
    log_phase "Pre-flight Checks"

    if [[ ! -d "$DOTFILES_ROOT/.git" ]] && [[ ! -f "$DOTFILES_ROOT/.git" ]]; then
        log_error "Not in a git repository"
        log_info "Run this from your dotfiles repository"
        exit 2
    fi
    log_success "Running in git repository"

    if ! command_exists git; then
        log_error "git is not installed"
        exit 2
    fi
    log_success "git is installed"

    log_info "Platform: $PLATFORM"
    log_info "Dotfiles root: $DOTFILES_ROOT"
}

# Install minimal Linux prerequisites through a supported native package manager.
install_linux_dependencies() {
    local packages=("$@")
    local package_manager=""
    local -a package_command=()
    local -a privilege_command=()

    if command_exists apt-get; then
        package_manager="apt-get"
        package_command=(env DEBIAN_FRONTEND=noninteractive apt-get install --yes)
    elif command_exists dnf; then
        package_manager="dnf"
        package_command=(dnf install --assumeyes)
    elif command_exists pacman; then
        package_manager="pacman"
        # Do not refresh pacman alone: `pacman -Sy package` risks a partial upgrade.
        package_command=(pacman --sync --needed --noconfirm)
    else
        log_error "Unsupported Linux package manager; install these dependencies manually: ${packages[*]}"
        exit 2
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "Would install Linux dependencies with $package_manager: ${packages[*]}"
        return 0
    fi

    if [[ "$EUID" -ne 0 ]]; then
        command_exists sudo || { log_error "sudo is required to install Linux dependencies"; exit 2; }
        privilege_command=(sudo)
    fi

    if [[ "$YES" != "true" ]]; then
        confirm "Install Linux dependencies with $package_manager: ${packages[*]}?" || {
            log_error "Linux dependencies are required to continue"
            exit 3
        }
    fi

    if [[ "$package_manager" == "apt-get" ]]; then
        if (( ${#privilege_command[@]} > 0 )); then
            "${privilege_command[@]}" env DEBIAN_FRONTEND=noninteractive apt-get update
        else
            env DEBIAN_FRONTEND=noninteractive apt-get update
        fi
    fi

    if (( ${#privilege_command[@]} > 0 )); then
        "${privilege_command[@]}" "${package_command[@]}" "${packages[@]}"
    else
        "${package_command[@]}" "${packages[@]}"
    fi
}

# Dependencies
phase_dependencies() {
    local missing_linux_dependencies=()

    log_phase "Dependencies"

    if command_exists jq; then
        log_success "jq is already installed ($(jq --version))"
    elif [[ "$PLATFORM" == "darwin" ]]; then
        log_error "jq is missing; use the Nix backend to install managed tools"
        exit 2
    else
        missing_linux_dependencies+=(jq)
    fi

    if [[ "$PLATFORM" == "linux" ]] && ! command_exists curl; then
        missing_linux_dependencies+=(curl)
    fi

    if (( ${#missing_linux_dependencies[@]} > 0 )); then
        install_linux_dependencies "${missing_linux_dependencies[@]}"
    fi
}

# Install the single runtime manager after the managed mise config is linked.
phase_mise() {
    log_phase "Mise Runtime Setup"

    local mise_config="$HOME/.config/mise/config.toml"
    if [[ ! -f "$mise_config" ]]; then
        mise_config="$DOTFILES_ROOT/home/.config/mise/config.toml"
    fi
    if ! command_exists mise; then
        if [[ "$DRY_RUN" == "true" ]]; then
            log_info "Would install mise"
        else
            [[ -f "$mise_config" ]] || {
                log_error "Managed mise config is missing"
                exit 2
            }
            confirm "Install mise for Node, Python, and Ruby?" || {
                log_error "Mise is required for managed runtimes"
                exit 3
            }
            run_remote_bash_installer "https://mise.run"
            export PATH="$HOME/.local/bin:$PATH"
        fi
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "Would install Node, Python, and Ruby from ~/.config/mise/config.toml"
        return 0
    fi

    command_exists mise || { log_error "mise installer did not provide mise"; exit 2; }
    [[ -f "$mise_config" ]] || {
        log_error "Managed mise config is missing"
        exit 2
    }
    MISE_GLOBAL_CONFIG_FILE="$mise_config" mise install --yes
}

# Prezto and Starship setup
phase_prezto() {
    log_phase "Prezto & Starship Setup"

    local prezto_dir="$HOME/.zprezto"

    # Check if Prezto is installed
    if [[ -d "$prezto_dir" ]]; then
        log_success "Prezto is already installed"
    else
        log_warning "Prezto is not installed"

        if [[ "$DRY_RUN" == "true" ]]; then
            log_info "Would clone Prezto to $prezto_dir"
        else
            if confirm "Install Prezto (zsh framework)?"; then
                log_info "Cloning Prezto..."
                if git clone --recursive https://github.com/sorin-ionescu/prezto.git "$prezto_dir"; then
                    log_success "Prezto installed"
                else
                    log_error "Failed to clone Prezto"
                    exit 1
                fi
            else
                log_warning "Skipped Prezto installation - shell features will be limited"
            fi
        fi
    fi

    if command -v starship >/dev/null 2>&1; then
        log_success "Starship is already installed"
    else
        log_warning "Starship is not installed"

        log_warning "Starship is not installed; the Nix backend provides the managed prompt"
    fi

    # Create Prezto runcom symlinks (for files not managed by our dotfiles)
    if [[ -d "$prezto_dir" ]]; then
        log_info "Creating Prezto runcom symlinks..."

        # Only create symlinks for runcoms NOT managed by our dotfiles
        # Our dotfiles manage: .zshenv, .zshrc, .zprofile, .zpreztorc
        # Prezto provides: .zlogin, .zlogout
        local -a prezto_runcoms=("zlogin" "zlogout")

        for runcom in "${prezto_runcoms[@]}"; do
            local source_file="$prezto_dir/runcoms/$runcom"
            local target_file="$HOME/.$runcom"

            if [[ -f "$source_file" ]]; then
                if [[ -L "$target_file" ]] && [[ "$(readlink "$target_file")" == "$source_file" ]]; then
                    log_verbose "Already linked: ~/.$runcom"
                elif [[ "$DRY_RUN" == "true" ]]; then
                    log_info "Would create: ~/.$runcom -> $source_file"
                else
                    ln -sf "$source_file" "$target_file"
                    log_success "Created: ~/.$runcom -> $source_file"
                fi
            fi
        done
    fi
}

# Invoke the dotfile linker with the shared installer flags.
run_linker() {
    local commands_only="$1"
    local linker="$DOTFILES_ROOT/bin/core/link-dotfiles.py"
    local link_args=()

    [[ -f "$linker" ]] || return 2
    [[ "$commands_only" == "true" ]] && link_args+=("--commands-only")
    if [[ "$DRY_RUN" == "true" ]]; then
        link_args+=("--dry-run")
    else
        link_args+=("--apply")
    fi
    [[ "$YES" == "true" ]] && link_args+=("--yes")
    [[ "$VERBOSE" == "true" ]] && link_args+=("--verbose")

    python3 "$linker" "${link_args[@]}"
}

# Symlink creation
phase_symlinks() {
    if [[ "$SKIP_LINKS" == "true" ]]; then
        log_info "Skipping symlink creation (--skip-links flag)"
        return 0
    fi

    log_phase "Symlink Creation"

    local linker_status

    log_info "Running link-dotfiles..."
    if run_linker false; then
        log_success "Symlinks created successfully"
        return 0
    else
        linker_status=$?
    fi

    if [[ "$linker_status" -eq 2 ]]; then
        log_error "link-dotfiles.py script not found: $DOTFILES_ROOT/bin/core/link-dotfiles.py"
        exit 2
    fi
    log_error "Symlink creation failed"
    exit 1
}

# Public command linking
phase_scripts_only() {
    local linker_status

    log_phase "Public Command Linking (~/.local/bin only)"
    log_info "Running link-dotfiles for public commands..."
    if run_linker true; then
        return 0
    else
        linker_status=$?
    fi

    if [[ "$linker_status" -eq 2 ]]; then
        log_error "link-dotfiles.py script not found: $DOTFILES_ROOT/bin/core/link-dotfiles.py"
        return 1
    fi
    log_error "Public command linking failed"
    return "$linker_status"
}

# Shell configuration
phase_shell() {
    log_phase "Shell Configuration"

    local current_shell="${SHELL##*/}"
    log_info "Current shell: $current_shell"

    # Check for .hushlogin to suppress login messages
    if [[ -f "$HOME/.hushlogin" ]]; then
        log_info ".hushlogin exists - login messages suppressed"
    else
        log_info ".hushlogin not found - login messages will be shown"
        if [[ "$DRY_RUN" != "true" ]]; then
            if confirm "Create .hushlogin to suppress login messages?"; then
                touch "$HOME/.hushlogin"
                log_success "Created ~/.hushlogin"
            else
                log_info "Skipped .hushlogin creation"
            fi
        else
            log_info "Would prompt to create ~/.hushlogin"
        fi
    fi

    case "$current_shell" in
        zsh)
            if [[ -L "$HOME/.config/zsh/.zshrc" ]]; then
                log_success "$HOME/.config/zsh/.zshrc is linked"
            else
                log_warning "$HOME/.config/zsh/.zshrc is not linked"
            fi
            ;;
        bash)
            if [[ -L "$HOME/.bashrc" ]]; then
                log_success "$HOME/.bashrc is linked"
            else
                log_info "$HOME/.bashrc is not managed by these dotfiles"
            fi
            ;;
        fish)
            log_info "Fish shell detected"
            ;;
        *)
            log_info "Detected shell: $current_shell"
            ;;
    esac
}

# Performance optimization (zsh)
phase_performance() {
    local current_shell="${SHELL##*/}"

    if [[ "$current_shell" != "zsh" ]]; then
        log_info "Skipping performance optimization (not using zsh)"
        return 0
    fi

    log_phase "Performance Optimization"

    local compile_script="$DOTFILES_ROOT/bin/core/zsh-compile"

    if [[ ! -f "$compile_script" ]]; then
        log_info "zsh-compile not found, skipping compilation"
        return 0
    fi

    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "Would compile zsh configuration files"
        return 0
    fi

    log_info "Compiling zsh configs for faster startup..."

    # Make executable if needed
    chmod +x "$compile_script" 2>/dev/null || true

    # Run compilation
    if command_exists zsh && zsh "$compile_script" &>/dev/null; then
        log_success "Zsh configs compiled to bytecode (.zwc)"
        log_info "Expected startup improvement: 100-200ms"
    else
        log_warning "Could not compile zsh configs (non-critical)"
    fi

    # Show performance info
    echo ""
    log_info "Performance features enabled:"
    echo "  - Mise selects Node, Python, and Ruby versions"
    echo "  - Compiled bytecode configs (.zwc files)"
    echo "  - Smart completion caching (24-hour refresh)"
    echo "  - Optimized history (10k entries)"
    echo ""
    log_info "To benchmark: zsh-benchmark"
}

# Show summary
show_summary() {
    log_phase "Installation Complete!"

    if [[ "$DRY_RUN" == "true" ]]; then
        log_info "This was a dry run - no changes were made"
        log_info "Run './install' (without --dry-run) to actually install"
    fi

    echo "Next Steps:"
    echo "  1. Restart your terminal or run: exec ${SHELL##*/}"
    echo "  2. Check environment: work-mode status"
    echo "  3. Verify git config: git config --list"
    echo ""

    # Show runtime verification commands
    echo "Verify Runtimes:"
    echo "  - mise ls"
    echo ""

    echo "Verify Paths (after shell restart):"
    echo "  - which python  # Should point to mise shims"
    echo "  - which ruby    # Should point to mise shims"
    echo "  - which node    # Should point to mise shims"
    echo ""

    # Zsh-specific tips
    if [[ "${SHELL##*/}" == "zsh" ]]; then
        echo ""
        echo "Zsh Performance Tips:"
        echo "  - Benchmark startup: zsh-benchmark"
        echo "  - After config changes: zsh-compile && exec zsh"
        echo "  - Trim history: zsh-trim-history"
        echo "  - Target: < 500ms startup time"
        echo ""
        echo "Mise selects the configured runtime on directory changes."
    fi

    echo ""
    echo "For help: ./install --help"
}

# Require a local Git worktree without fetching or synchronizing it.
validate_dotfiles_worktree() {
    if [[ ! -d "$DOTFILES_ROOT/.git" && ! -f "$DOTFILES_ROOT/.git" ]]; then
        log_error "Not in a git repository"
        log_info "Run this from your dotfiles repository"
        exit 2
    fi
    command_exists git || { log_error "git is not installed"; exit 2; }
}

# Return success when Home Manager has previously activated this user profile.
home_manager_profile_exists() {
    local home_manager_profile="$HOME/.local/state/nix/profiles/home-manager"
    [[ -e "$home_manager_profile" || -L "$home_manager_profile" ]]
}

# Resolve automatic selection from the supported platform contract.
select_automatic_backend() {
    case "$PLATFORM" in
        darwin) printf '%s\n' "nix" ;;
        linux) printf '%s\n' "legacy" ;;
        *) return 1 ;;
    esac
}

# Reject options that the selected mode would otherwise ignore.
validate_install_options() {
    local selected_backend="$1"

    if [[ "$SCRIPTS_ONLY" == "true" ]]; then
        if [[ -n "$BACKEND_SELECTOR" || "$SYSTEM_MODE" == "true" || -n "$CONFIGURATION" || \
            -n "$USERNAME_VALUE" || -n "$MACHINE_NAME" || "$SKIP_NPM" == "true" || \
            "$NIX_DISTRIBUTION_EXPLICIT" == "true" || "$ALLOW_MIXED_BACKENDS" == "true" || \
            "$SKIP_PACKAGES" == "true" || "$SKIP_LINKS" == "true" ]]; then
            log_error "--scripts-only cannot be combined with backend or package options"
            exit 2
        fi
        return 0
    fi

    case "$selected_backend" in
        nix)
            [[ "$PLATFORM" == "darwin" ]] || { log_error "Nix backend is supported only on macOS"; exit 2; }
            if [[ "$SKIP_PACKAGES" == "true" || "$SKIP_LINKS" == "true" || \
                "$ALLOW_MIXED_BACKENDS" == "true" ]]; then
                log_error "Legacy options cannot be used with the Nix backend"
                exit 2
            fi
            ;;
        legacy)
            [[ "$PLATFORM" == "darwin" || "$PLATFORM" == "linux" ]] || {
                log_error "Legacy backend is supported only on macOS and Linux"
                exit 2
            }
            if [[ "$SYSTEM_MODE" == "true" || -n "$CONFIGURATION" || -n "$USERNAME_VALUE" || \
                -n "$MACHINE_NAME" || "$SKIP_NPM" == "true" || "$NIX_DISTRIBUTION_EXPLICIT" == "true" ]]; then
                log_error "Nix options cannot be used with the legacy backend"
                exit 2
            fi
            if [[ "$PLATFORM" == "darwin" && "$ALLOW_MIXED_BACKENDS" != "true" ]] && home_manager_profile_exists; then
                log_error "Legacy backend refused: Home Manager already manages this macOS user"
                log_info "Use --allow-mixed-backends only for deliberate recovery"
                exit 2
            fi
            ;;
        *) log_error "Internal error: unknown selected backend $selected_backend"; exit 2 ;;
    esac
}

# Show the shared installer banner before backend-specific output.
show_install_banner() {
    echo "================================================="
    echo " Dotfiles Installation"
    echo "================================================="
    echo ""
}

# Print the top-level plan before invoking a backend.
show_install_selection() {
    local selected_backend="$1"
    local selection_reason="$2"

    log_info "Selected backend: $selected_backend ($selection_reason)"
    if [[ "$DRY_RUN" == "true" ]]; then
        log_warning "DRY RUN MODE - No changes will be made"
    fi
    if [[ -n "$(git -C "$DOTFILES_ROOT" status --porcelain 2>/dev/null || true)" ]]; then
        log_warning "Using a dirty dotfiles worktree without Git synchronization"
    fi
}

# Run only the public command linker without selecting a package-management backend.
run_scripts_only() {
    log_info "Scripts-only mode: skipping backend selection"
    phase_preflight
    phase_scripts_only
    log_phase "Scripts Update Complete!"
    log_info "Public commands in ~/.local/bin have been updated"
}

# Delegate one explicit Nix backend invocation with its compatible options.
run_nix_backend() {
    local nix_bootstrap="$DOTFILES_ROOT/bin/core/nix-bootstrap"
    local nix_args=()

    [[ -x "$nix_bootstrap" ]] || { log_error "Nix bootstrap script not found: bin/core/nix-bootstrap"; exit 2; }
    [[ "$SYSTEM_MODE" == "true" ]] && nix_args+=(--system)
    [[ -n "$CONFIGURATION" ]] && nix_args+=(--configuration "$CONFIGURATION")
    [[ -n "$USERNAME_VALUE" ]] && nix_args+=(--username "$USERNAME_VALUE")
    [[ -n "$MACHINE_NAME" ]] && nix_args+=(--machine-name "$MACHINE_NAME")
    [[ "$SKIP_NPM" == "true" ]] && nix_args+=(--skip-npm)
    [[ "$NIX_DISTRIBUTION_EXPLICIT" == "true" ]] && nix_args+=(--nix-distribution "$NIX_DISTRIBUTION")
    [[ "$DRY_RUN" == "true" ]] && nix_args+=(--dry-run)
    [[ "$YES" == "true" ]] && nix_args+=(--yes)

    log_info "Delegating to bin/core/nix-bootstrap"
    if (( ${#nix_args[@]} > 0 )); then
        exec "$nix_bootstrap" "${nix_args[@]}"
    else
        exec "$nix_bootstrap"
    fi
}

# Run the retained imperative installer after router validation.
run_legacy_backend() {
    phase_preflight
    if [[ "$SKIP_PACKAGES" != "true" ]]; then
        phase_dependencies
    fi
    phase_prezto
    phase_symlinks
    phase_mise
    phase_shell
    phase_performance
    show_summary
}

# Main execution
main() {
    local selected_backend selection_reason

    parse_args "$@"
    trap 'log_error "Installation failed"; exit 1' ERR
    validate_dotfiles_worktree
    show_install_banner

    if [[ "$SCRIPTS_ONLY" == "true" ]]; then
        validate_install_options "scripts-only"
        run_scripts_only
        exit 0
    fi

    if [[ "$BACKEND" == "auto" ]]; then
        if ! selected_backend="$(select_automatic_backend)"; then
            log_error "Unsupported platform: $PLATFORM"
            exit 2
        fi
        selection_reason="$PLATFORM default"
    else
        selected_backend="$BACKEND"
        selection_reason="explicit --backend $BACKEND"
    fi

    validate_install_options "$selected_backend"
    show_install_selection "$selected_backend" "$selection_reason"

    case "$selected_backend" in
        nix) run_nix_backend ;;
        legacy) run_legacy_backend ;;
    esac
}

main "$@"
