# Generated by .agent-scaffold/regenerate_qa.py.

name: Agent repository QA
on:
  pull_request:
  push:
    branches: [{{ repository.default_branch }}]

# Cancel superseded runs so a newer push stops the previous run.
concurrency:
  group: qa-{% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read
jobs:
  deterministic-qa:
    runs-on: depot-ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
      - uses: astral-sh/setup-uv@d0cc045d04ccac9d8b7881df0226f9e82c39688e
      - name: Validate agent repository
        run: uv run scripts/qa_repository.py .
